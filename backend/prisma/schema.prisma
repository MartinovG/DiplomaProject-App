generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  namespace String
  action    String   // SLEEP, WAKE, AUTO_SLEEP, AUTO_WAKE
  reason    String?
  timestamp DateTime @default(now())

  @@index([namespace, timestamp])
}

model Environment {
  namespace        String   @id
  lastActivityAt   DateTime @default(now())
  idleTimeoutMin   Int      @default(30)
  autoSleepEnabled Boolean  @default(true)
  hourlyCostUsd    Float    @default(0.04)
}
